{
  "name": "a11y-playtest-captioner",
  "version": "0.1.0",
  "description": "Author-controlled, localized game-state descriptions with keyboard and on-device speech review.",
  "type": "module",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    }
  },
  "files": [
    "dist/lib",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json --emitDeclarationOnly",
    "build:site": "vite build --config vite.site.config.ts",
    "build": "npm run clean && npm run build:lib && npm run build:site",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:site && playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "keywords": [
    "accessibility",
    "game-development",
    "canvas",
    "captions",
    "speech-synthesis"
  ],
  "author": "Sociobot (Param Factory)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@fontsource/atkinson-hyperlegible": "5.2.6",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "assertion-error": "^2.0.1",
    "axe-core": "^4.10.3",
    "cac": "^6.7.14",
    "chai": "^5.3.3",
    "check-error": "^2.1.3",
    "debug": "^4.4.3",
    "deep-eql": "^5.0.2",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.28.2",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.4.0",
    "fdir": "^6.5.0",
    "js-tokens": "^9.0.1",
    "loupe": "^3.2.1",
    "magic-string": "^0.30.21",
    "ms": "^2.1.3",
    "nanoid": "^3.3.18",
    "pathe": "^2.0.3",
    "pathval": "^2.0.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "playwright": "^1.58.2",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "rollup": "^4.63.0",
    "siginfo": "^2.0.0",
    "source-map-js": "^1.2.1",
    "stackback": "^0.0.2",
    "std-env": "^3.10.0",
    "strip-literal": "^3.1.0",
    "tinybench": "^2.9.0",
    "tinyexec": "^0.3.2",
    "tinyglobby": "^0.2.17",
    "tinypool": "^1.1.1",
    "tinyrainbow": "^2.0.0",
    "tinyspy": "^4.0.4",
    "undici-types": "^7.10.0",
    "vite-node": "^3.2.4",
    "why-is-node-running": "^2.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B-Divyesh/sf-a11y-playtest-captioner.git"
  },
  "bugs": {
    "url": "https://github.com/B-Divyesh/sf-a11y-playtest-captioner/issues"
  },
  "homepage": "https://github.com/B-Divyesh/sf-a11y-playtest-captioner#readme"
}
